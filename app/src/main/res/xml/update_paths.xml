<?xml version="1.0" encoding="utf-8"?>
<!--
  The one directory a downloaded update is written to, and the one in the cache what the listener
  chooses to share is (the "Итоги" card, the journal), and nothing else. A FileProvider is a hole
  through the sandbox; the installer and the share sheet only need the file they were just handed,
  while the rest of filesDir holds downloaded music and the account tokens.
-->
<paths>
    <files-path
        name="updates"
        path="updates/" />
    <cache-path
        name="shared"
        path="shared/" />
</paths>

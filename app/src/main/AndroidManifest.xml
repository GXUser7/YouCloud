<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Whether the network is metered: downloaded tracks' videos are fetched only when it isn't. -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- Hands a downloaded update to the system installer; the user still confirms it there. -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:usesCleartextTraffic="true"
        android:theme="@style/Theme.MyApplication">

        <!-- Tells Android Auto this app provides media; without it the app never appears in the car. -->
        <meta-data
            android:name="com.google.android.gms.car.application"
            android:resource="@xml/automotive_app_desc" />

        <!-- Colour hint for the car interface. See the CarTheme comment in themes.xml. -->
        <meta-data
            android:name="com.google.android.gms.car.application.theme"
            android:resource="@style/CarTheme" />

        <!-- Serves cached cover art to the Android Auto host process, read-only. Exported because
             that process is a different app and cannot otherwise open the files; the provider
             hands out nothing but the JPEGs we cached for downloaded tracks. -->
        <provider
            android:name=".data.ArtworkProvider"
            android:authorities="com.example.myapplication.artwork"
            android:exported="true"
            android:grantUriPermissions="true" />

        <!-- Turning the phone doesn't recreate the activity: Compose lays itself out again, and a
             music video playing in the player carries on instead of starting to load over. -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden"
            android:label="@string/app_name"
            android:theme="@style/Theme.MyApplication">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Serves cached cover art to the Android Auto host, which renders browse lists in its own
             process and so cannot read our private files. Read-only, and it only ever opens JPEGs
             from the artwork directory. -->
        <provider
            android:name=".data.ArtworkProvider"
            android:authorities="com.example.myapplication.artwork"
            android:exported="true"
            android:grantUriPermissions="true" />

        <!-- Gives the package installer read access to a downloaded update, and to nothing else:
             scoped to one directory in @xml/update_paths, and not exported. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.updates"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/update_paths" />
        </provider>

        <!-- Exported so the Android Auto host process can bind to the browser service; the session
             itself still decides who may connect. -->
        <service
            android:name=".player.PlaybackService"
            android:exported="true"
            android:foregroundServiceType="mediaPlayback">
            <intent-filter>
                <action android:name="androidx.media3.session.MediaLibraryService" />
                <action android:name="androidx.media3.session.MediaSessionService" />
                <action android:name="android.media.browse.MediaBrowserService" />
            </intent-filter>
        </service>
    </application>

</manifest>

{
  "manifest_version": 3,
  "name": "YouCloud — домашний IP",
  "short_name": "YouCloud",
  "version": "0.5.0",
  "description": "Даёт сайту YouCloud ходить в Яндекс Музыку и YouTube с твоего IP и входить в SoundCloud и Яндекс без копирования токенов.",
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "key": "",
  "permissions": [
    "declarativeNetRequestWithHostAccess",
    "storage",
    "cookies",
    "webRequest",
    "scripting"
  ],
  "host_permissions": [
    "https://*.yandex.net/*",
    "https://*.youtube.com/*",
    "https://youtubei.googleapis.com/*",
    "https://soundcloud.com/*",
    "https://api-v2.soundcloud.com/*",
    "https://youcloud.inkerror67.workers.dev/*",
    "http://localhost:5190/*"
  ],
  "background": {
    "service_worker": "background.js",
    "scripts": [
      "background.js"
    ]
  },
  "content_scripts": [
    {
      "matches": [
        "https://youcloud.inkerror67.workers.dev/*",
        "http://localhost:5190/*"
      ],
      "js": [
        "bridge.js"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://music.yandex.ru/*",
        "https://music.yandex.com/*"
      ],
      "js": [
        "yandex-token.js"
      ],
      "run_at": "document_start"
    }
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "youcloud-bridge@gxuser7",
      "strict_min_version": "128.0"
    }
  }
}
